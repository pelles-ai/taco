# TACO Sandbox Demo — LLM Configuration
#
# Choose your LLM provider and set the API key.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# To use OpenAI instead, uncomment below and comment out the Anthropic lines:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Token for the agents' /admin/skills endpoints, which the dashboard's
# "Add VE Skill" button uses. `make demo-env` fills in a random one, and
# run_demo.py generates one for its run if this is empty.
TACO_ADMIN_TOKEN=

# Optional: have the estimating agent fetch supplier pricing from the
# supplier agent before estimating (agent-to-agent call). For local runs:
# SUPPLIER_AGENT_URL=http://localhost:8002
